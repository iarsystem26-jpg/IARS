VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Must match the Supabase WebAuthn RP ID; passkeys only work on this domain/subdomains.
VITE_PASSKEY_RP_ID=
# Public Google OAuth web client ID; also set GOOGLE_CLIENT_ID on the Edge Function.
VITE_GOOGLE_CLIENT_ID=
# Optional override for the deployed Google Apps Script profile image API.
VITE_GOOGLE_DRIVE_GAS_URL=
# Show account identifiers only. Passwords are never included in the client.
VITE_SHOW_TEST_ACCOUNTS=false

# Optional, verified school contact details. Empty values are not displayed.
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_CAMPUS_NAME=
VITE_CAMPUS_MAP_URL=

# Verified details of the institution responsible for student information.
VITE_SCHOOL_LEGAL_NAME=
VITE_PRIVACY_EMAIL=
VITE_PRIVACY_OFFICE=

# One deployment/origin and one Supabase project per educational unit.
# Keep the ID stable after launch. This is branding, never an authorization claim.
VITE_EDUCATIONAL_UNIT_ID=iars
VITE_INSTITUTION_NAME=
VITE_INSTITUTION_SHORT_NAME=
# Place unit PNG assets inside public/ and reference them with /absolute-path.png.
VITE_INSTITUTION_LOGO=/iars-icon.png
VITE_INSTITUTION_PRIMARY_COLOR="#0066ff"
VITE_INSTITUTION_ACCENT_COLOR="#00b88a"
VITE_PWA_ICON_192=/icons/pwa-192.png
VITE_PWA_ICON_512=/icons/pwa-512.png
VITE_PWA_MASKABLE_ICON=/icons/pwa-maskable-512.png
VITE_APPLE_TOUCH_ICON=/icons/apple-touch-icon.png
